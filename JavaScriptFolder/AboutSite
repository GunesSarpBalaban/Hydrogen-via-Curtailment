// ======================================================
// About Site Modal
// ======================================================
//
// Wires up the "?" button next to the PDF export button — opens a
// modal with an "About this site" section (what the site is, and
// where its data actually comes from). Content lives directly in
// index.html; this file only handles opening/closing.
//
// Wrapped in an IIFE with a load-guard, matching this codebase's other
// scripts.

(function () {

    if (window.__aboutSiteLoaded) {
        console.log("aboutSite.js already loaded — skipping re-init (likely a live-reload re-inject).");
        return;
    }
    window.__aboutSiteLoaded = true;

    function initAboutSite() {
        const btn = document.getElementById("aboutSiteBtn");
        const overlay = document.getElementById("aboutSiteOverlay");
        const closeBtn = document.getElementById("aboutSiteCloseBtn");
        if (!btn || !overlay || !closeBtn) return;

        const open = () => overlay.classList.remove("hidden");
        const close = () => overlay.classList.add("hidden");

        btn.addEventListener("click", open);
        closeBtn.addEventListener("click", close);

        // Clicking the dark backdrop (outside the modal box itself)
        // also closes it — standard modal behaviour.
        overlay.addEventListener("click", (e) => {
            if (e.target === overlay) close();
        });

        // Escape key closes it too, but only while it's actually open.
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !overlay.classList.contains("hidden")) close();
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAboutSite);
    } else {
        initAboutSite();
    }

})();
